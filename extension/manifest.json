{
  "manifest_version": 3,
  "name": "Whalekeeper",
  "version": "0.3.2",
  "description": "Whalekeeper — 一键管理 DeepSeek Harness (dsh) web 服务生命周期（启动/停止/重启）。需要本机安装 dsh 与随附的 Native Messaging 宿主。Whalekeeper — Manage the DeepSeek Harness (dsh) web service lifecycle (start/stop/restart) from your browser. Requires dsh and the bundled native host installed on this machine.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "dsh-manager@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "nativeMessaging", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Whalekeeper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content/panel.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
